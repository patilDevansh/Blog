# Netlify (or `netlify dev`) — never commit real values
# Use Site configuration → Environment variables in production.

# Single secret: sign-in, AI generate, and publish.
CREATOR_PASSWORD=

OPENAI_API_KEY=

# --- Storage (choose one) ---

# Recommended for scale: serverless Postgres (Neon, Supabase pooler, etc.).
# Run netlify/db/schema.sql once on the database, then set:
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Legacy: GitHub-backed manifests (used only when DATABASE_URL is unset).
GITHUB_REPO=
GITHUB_TOKEN=
# GITHUB_BRANCH=main
# GITHUB_CONTENT_PREFIX=interactive/content/publishes

# Optional
# OPENAI_MODEL=gpt-4o-mini
# UNSPLASH_ACCESS_KEY=

# Optional: override public manifest endpoint (default /.netlify/functions/public-manifests)
# VITE_PUBLIC_MANIFESTS_URL=https://yoursite.netlify.app/.netlify/functions/public-manifests
